# Example environment for OneID. Copy to `.env` and edit.
# `tool_server/utils/paths.py` loads `.env` with setdefault semantics, so real
# environment variables always win over this file.

# ---- roots -----------------------------------------------------------------
# Where model checkpoints live (language models, detection models, ...).
CHECKPOINT_ROOT=/abs/path/to/checkpoints
# Intermediate / downloadable model weights used by individual tools.
LOCAL_MODEL_ROOT=models

# ---- data ------------------------------------------------------------------
# Directory holding match_images/ and time_images/ (see README "Data").
# Defaults to <repo>/data when unset.
ONEID_DATA_ROOT=/abs/path/to/oneid-data

# ---- cross-modal engine ----------------------------------------------------
# Default reasoning mode for CrossModalInterpret:
#   shared_identity (default) | vi_only | candidate_graph | legacy_hard
ONEID_DEFAULT_MODE=shared_identity
# Soft per-request budget in seconds (degrades at stage boundaries).
ONEID_DSVI_BUDGET_SECONDS=120
# Observation cap; above it the request degrades to vi_only.
ONEID_DSVI_MAX_OBSERVATIONS=800

# ---- UI --------------------------------------------------------------------
# GPU used by the UI agent model: an index (0, 1, ...) or "cpu".
ONEID_DEVICE=0

# Optional logo shown in the app header (leave empty to hide it).
LOGO_PATH=

# ---- evaluation APIs -------------------------------------------------------
# Never commit real keys; export them in the shell that runs the evaluation.
# EVAL_MODEL_API_KEY=
# JUDGE_API_KEY=
# DEEPSEEK_API_KEY=
